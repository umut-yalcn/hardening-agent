# Hangi saglayici kullanilacak: google | anthropic
LLM_PROVIDER=google

# Google AI Studio (ucretsiz katman): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic (opsiyonel)
ANTHROPIC_API_KEY=

# Model secimi - bos birakilirsa saglayiciya gore varsayilan atanir.
LLM_MODEL=
EMBEDDING_MODEL=

# Veri yollari (opsiyonel)
SUNUCU_YOLU=
SONUC_YOLU=
CHROMA_PATH=chroma_store
